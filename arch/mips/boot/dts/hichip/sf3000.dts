/dts-v1/;

#include "hc16xx.dtsi"

/ {
	compatible = "datafrog,sf3000", "noname,sf3000";
	model = "SF3000";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		bootargs = "console=ttyS0,115200 earlycon root=/dev/mmcblk0p1 rw rootwait";
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x10000000>;
	};
};

&pinctrl {
	uart0_pins: pins-uart0 {
		function = "uart0";
		pins = "l12";
		drive-strength = <2>;
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";

	status = "okay";
};
